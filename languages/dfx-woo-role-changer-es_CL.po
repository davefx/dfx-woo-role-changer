#. Plugin Name of the plugin
#: dfx-woo-role-changer.php
msgid "Membership & User Roles for WooCommerce (Automatic Role Changer)"
msgstr "Membership & User Roles for WooCommerce (Automatic Role Changer)"

#. Description of the plugin
#: dfx-woo-role-changer.php
msgid "Sync user roles with memberships and subscriptions. Grant access on purchase, revoke on expiry, and restrict your store by role."
msgstr "Sincroniza los perfiles de usuario con membresías y suscripciones. Concede acceso al comprar, revócalo al caducar y restringe tu tienda por perfil."

#. Author of the plugin
#: dfx-woo-role-changer.php
msgid "David Marín Carreño"
msgstr "David Marín Carreño"

#. Author URI of the plugin
#: dfx-woo-role-changer.php
msgid "https://davefx.com"
msgstr "https://davefx.com"

#: dfx-woo-role-changer-memberpress.php:120
msgid "Pending"
msgstr "Pendiente"

#: dfx-woo-role-changer-memberpress.php:121
msgid "Active"
msgstr "Activa"

#: dfx-woo-role-changer-memberpress.php:122
msgid "Suspended"
msgstr "Suspendida"

#: dfx-woo-role-changer-memberpress.php:123
msgid "Cancelled"
msgstr "Cancelada"

#: dfx-woo-role-changer-memberpress.php:124
msgid "Expired"
msgstr "Caducada"

#: dfx-woo-role-changer-memberpress.php:281
msgid "Role assignment"
msgstr "Asignación de perfiles"

#: dfx-woo-role-changer-memberpress.php:300
msgid "The free version syncs a single membership level, and another membership is already mapped."
msgstr "La versión gratuita sincroniza un único nivel de membresía, y ya hay otra membresía asignada."

#: dfx-woo-role-changer-memberpress.php:306
msgid "Upgrade to Pro to map unlimited membership levels."
msgstr "Actualiza a Pro para asignar niveles de membresía ilimitados."

#: dfx-woo-role-changer-memberpress.php:314 dfx-woo-role-changer.php:266
msgid "None"
msgstr "Ninguno"

#: dfx-woo-role-changer-memberpress.php:356
msgid "Roles are granted when the membership enters the state and revoked when it leaves it."
msgstr "Los perfiles se conceden cuando la membresía entra en el estado y se retiran cuando sale de él."

#: dfx-woo-role-changer-memberpress.php:362
msgid "Upgrade to Pro for unlimited levels, several roles per membership, and mapping of every membership state."
msgstr "Actualiza a Pro para tener niveles ilimitados, varios perfiles por membresía y asignación de todos los estados de la membresía."

#: dfx-woo-role-changer-memberpress.php:434
msgid "MemberPress detected. Map membership states to roles from each membership's edit screen."
msgstr "MemberPress detectado. Asigna perfiles a los estados de membresía desde la pantalla de edición de cada membresía."

#: dfx-woo-role-changer-memberpress.php:438
msgid "The free version syncs a single membership level, granting a role while the membership is active."
msgstr "La versión gratuita sincroniza un único nivel de membresía, concediendo un perfil mientras la membresía está activa."

#: dfx-woo-role-changer-memberpress.php:445
msgid "MemberPress integration"
msgstr "Integración con MemberPress"

#. translators: %d: renewal order ID
#: dfx-woo-role-changer-premium-features.php:220
#, php-format
msgid "Subscription renewal payment (order #%d) failed or is in on-hold status."
msgstr "El pago de renovación de la suscripción (pedido #%d) ha fallado o está en espera."

#. translators: 1: subscription order ID, 2: subscription status
#: dfx-woo-role-changer-premium-features.php:237
#, php-format
msgid "Subscription #%1$d status: %2$s."
msgstr "Suscripción #%1$d, estado: %2$s."

#. translators: 1: subscription order ID, 2: new subscription status
#: dfx-woo-role-changer-premium-features.php:250
#, php-format
msgid "Subscription #%1$d changed its status to %2$s."
msgstr "La suscripción #%1$d ha cambiado su estado a %2$s."

#. translators: 1: role name
#: dfx-woo-role-changer-premium-features.php:599
#, php-format
msgid "Role \"%1$s\" will not be removed because it is associated with another active subscription."
msgstr "El perfil «%1$s» no se retirará porque está asociado a otra suscripción activa."

#: dfx-woo-role-changer-premium-features.php:611
msgid "Removing role pending from previous switch after subscription status change."
msgstr "Retirando el perfil pendiente del cambio anterior tras la modificación del estado de la suscripción."

#: dfx-woo-role-changer-premium-features.php:661
msgid "Adding role after successful switch."
msgstr "Añadiendo el perfil tras el cambio realizado correctamente."

#. translators: 1: role name
#: dfx-woo-role-changer-premium-features.php:674
#, php-format
msgid "Role \"%1$s\" will be removed when the subscription gets into on-hold status (in the next renewal)."
msgstr "El perfil «%1$s» se retirará cuando la suscripción pase al estado en espera (en la próxima renovación)."

#: dfx-woo-role-changer-premium-features.php:685
msgid "Role on purchase"
msgstr "Perfil al comprar"

#: dfx-woo-role-changer-premium-features.php:689
msgid "Select role to assign upon purchase of this variation."
msgstr "Selecciona el perfil a asignar al comprar esta variación."

#: dfx-woo-role-changer-premium-features.php:697
#: dfx-woo-role-changer-premium-features.php:843
msgid "Role expiration enabled"
msgstr "Caducidad del perfil activada"

#: dfx-woo-role-changer-premium-features.php:698
#: dfx-woo-role-changer-premium-features.php:844
msgid "Enable scheduled role expiration for this product."
msgstr "Activa la caducidad programada del perfil para este producto."

#: dfx-woo-role-changer-premium-features.php:707
#: dfx-woo-role-changer-premium-features.php:850
msgid "Days before role expiration"
msgstr "Días hasta la caducidad del perfil"

#: dfx-woo-role-changer-premium-features.php:708
#: dfx-woo-role-changer-premium-features.php:851
msgid "Enter the number of days the role will be active after the product is purchased."
msgstr "Introduce el número de días que el perfil estará activo tras la compra del producto."

#: dfx-woo-role-changer-premium-features.php:762
msgid "Multiple expiration mode"
msgstr "Modo de caducidad múltiple"

#: dfx-woo-role-changer-premium-features.php:766
msgid "Sum lengths for all products"
msgstr "Sumar la duración de todos los productos"

#: dfx-woo-role-changer-premium-features.php:767
msgid "Use the longest time period"
msgstr "Usar el periodo más largo"

#: dfx-woo-role-changer-premium-features.php:768
msgid "Use the shortest time period"
msgstr "Usar el periodo más corto"

#: dfx-woo-role-changer-premium-features.php:771
msgid "Select how to handle multiple products in the same order defining expirations for the same role."
msgstr "Selecciona cómo tratar varios productos del mismo pedido que definan caducidades para el mismo perfil."

#: dfx-woo-role-changer-premium-features.php:777
msgid " (for non-subscription products)"
msgstr " (para productos que no son suscripciones)"

#: dfx-woo-role-changer-premium-features.php:778
msgid " (Only for non-subscription products)"
msgstr " (Solo para productos que no son suscripciones)"

#: dfx-woo-role-changer-premium-features.php:781
msgid "Roles associated to subscription products"
msgstr "Perfiles asociados a productos de suscripción"

#: dfx-woo-role-changer-premium-features.php:786
msgid "Subscription products will get roles assigned when subscription is activated and removed when the subscription is cancelled or paused."
msgstr "Los productos de suscripción asignarán perfiles cuando la suscripción se active, y los retirarán cuando se cancele o se pause."

#: dfx-woo-role-changer-premium-features.php:791
msgid "WooCommerce Subscriptions plugin detected."
msgstr "Plugin WooCommerce Subscriptions detectado."

#: dfx-woo-role-changer-premium-features.php:794
msgid "YITH WooCommerce Subscription plugin detected."
msgstr "Plugin YITH WooCommerce Subscription detectado."

#: dfx-woo-role-changer-premium-features.php:797
msgid "Subscriptions for WooCommerce plugin detected."
msgstr "Plugin Subscriptions for WooCommerce detectado."

#. translators: 1: role name, 2: username, 3: new order edit url, 4: new order id
#: dfx-woo-role-changer-premium-features.php:1046
#, php-format
msgid "Role \"%1$s\" expiration period for user \"%2$s\" has been updated by order <a href=\"%3$s\">#%4$d</a>."
msgstr "El periodo de caducidad del perfil «%1$s» para el usuario «%2$s» ha sido actualizado por el pedido <a href=\"%3$s\">#%4$d</a>."

#. translators: 1: previous order edit URL, 2: previous order ID
#: dfx-woo-role-changer-premium-features.php:1052
#, php-format
msgid ", extending previous expiration period defined in order <a href=\"%1$s\">#%2$d</a>."
msgstr ", ampliando el periodo de caducidad anterior definido en el pedido <a href=\"%1$s\">#%2$d</a>."

#. translators: 1: role name, 2: username, 3: date when the role will expire, 4: optional message explaining the extension of the role validity
#: dfx-woo-role-changer-premium-features.php:1065
#, php-format
msgid "Scheduling expiration of role \"%1$s\" for user \"%2$s\" at %3$s%4$s."
msgstr "Programando la caducidad del perfil «%1$s» para el usuario «%2$s» el %3$s%4$s."

#: dfx-woo-role-changer-premium-features.php:1086
msgid "Role expired."
msgstr "Perfil caducado."

#: dfx-woo-role-changer-restrictions.php:464
#: dfx-woo-role-changer-restrictions.php:516
msgid "You do not have access to that product."
msgstr "No tienes acceso a ese producto."

#: dfx-woo-role-changer-restrictions.php:758
#: dfx-woo-role-changer-restrictions.php:842
#: dfx-woo-role-changer-restrictions.php:858
msgid "Restrict to roles"
msgstr "Restringir a los perfiles"

#: dfx-woo-role-changer-restrictions.php:760
msgid "Leave empty for no restriction. Otherwise only these roles can see and buy the product."
msgstr "Déjalo vacío para no aplicar restricción. Si no, solo estos perfiles podrán ver y comprar el producto."

#: dfx-woo-role-changer-restrictions.php:765
msgid "Per-role prices"
msgstr "Precios por perfil"

#: dfx-woo-role-changer-restrictions.php:765
msgid "Leave a field empty to use the normal price. If a user has several roles with a price, the lowest applies."
msgstr "Deja un campo vacío para usar el precio normal. Si un usuario tiene varios perfiles con precio, se aplica el más bajo."

#: dfx-woo-role-changer-restrictions.php:844
msgid "Leave empty for no restriction."
msgstr "Déjalo vacío para no aplicar restricción."

#: dfx-woo-role-changer-restrictions.php:860
msgid "Leave empty for no restriction. Products in this category inherit it."
msgstr "Déjalo vacío para no aplicar restricción. Los productos de esta categoría la heredan."

#: dfx-woo-role-changer-restrictions.php:907
msgid "Restricted product URL"
msgstr "URL de producto restringido"

#: dfx-woo-role-changer-restrictions.php:911
msgid "Return a 404 (does not reveal the product exists)"
msgstr "Devolver un 404 (no revela que el producto existe)"

#: dfx-woo-role-changer-restrictions.php:912
msgid "Redirect to the shop page with a notice"
msgstr "Redirigir a la página de la tienda con un aviso"

#: dfx-woo-role-changer-restrictions.php:915
msgid "What happens when someone opens the URL of a product their role cannot access."
msgstr "Qué ocurre cuando alguien abre la URL de un producto al que su perfil no tiene acceso."

#. translators: %s: gateway title
#: dfx-woo-role-changer-restrictions.php:925
#, php-format
msgid "Payment: %s"
msgstr "Pago: %s"

#: dfx-woo-role-changer-restrictions.php:929
msgid "Roles allowed to use this gateway. Empty means everyone."
msgstr "Perfiles autorizados a usar esta pasarela. Vacío significa todos."

#. translators: %s: shipping method title
#: dfx-woo-role-changer-restrictions.php:939
#, php-format
msgid "Shipping: %s"
msgstr "Envío: %s"

#: dfx-woo-role-changer-restrictions.php:943
msgid "Roles allowed to use this shipping method. Empty means everyone."
msgstr "Perfiles autorizados a usar este método de envío. Vacío significa todos."

#: dfx-woo-role-changer-retroactive.php:216
#: dfx-woo-role-changer-retroactive.php:217
#: dfx-woo-role-changer-retroactive.php:231
msgid "Retroactive role sync"
msgstr "Sincronización retroactiva de perfiles"

#: dfx-woo-role-changer-retroactive.php:235
msgid "Nothing to sync from: neither MemberPress nor a supported subscription plugin is active."
msgstr "No hay nada desde donde sincronizar: ni MemberPress ni ningún plugin de suscripciones compatible está activo."

#. translators: %d: number of mapped memberships
#: dfx-woo-role-changer-retroactive.php:250
#, fuzzy, php-format
msgid "%d mapped MemberPress membership"
msgid_plural "%d mapped MemberPress memberships"
msgstr[0] "%d membresía de MemberPress asignada"
msgstr[1] "%d membresías de MemberPress asignadas"

#: dfx-woo-role-changer-retroactive.php:262
msgid "No membership has a role mapping yet. Configure one on a membership edit screen first."
msgstr "Todavía no hay ninguna membresía con perfiles asignados. Configura una primero en la pantalla de edición de una membresía."

#. translators: %s: comma separated list of sources, e.g. "2 mapped MemberPress memberships, WooCommerce Subscriptions"
#: dfx-woo-role-changer-retroactive.php:272
#, php-format
msgid "This aligns every existing user's roles with what they currently hold in: %s. It is safe to run more than once."
msgstr "Esto alinea los perfiles de todos los usuarios existentes con lo que tienen actualmente en: %s. Se puede ejecutar más de una vez sin problema."

#: dfx-woo-role-changer-retroactive.php:280
msgid "Run retroactive sync"
msgstr "Ejecutar sincronización retroactiva"

#. translators: 1: users processed so far, 2: total users
#: dfx-woo-role-changer-retroactive.php:306
#, php-format
msgid "%1$d of %2$d users processed."
msgstr "%1$d de %2$d usuarios procesados."

#. translators: 1: users processed, 2: roles granted, 3: roles revoked
#: dfx-woo-role-changer-retroactive.php:308
#, php-format
msgid "Done. %1$d users processed, %2$d roles granted, %3$d roles revoked."
msgstr "Hecho. %1$d usuarios procesados, %2$d perfiles concedidos, %3$d perfiles retirados."

#: dfx-woo-role-changer-retroactive.php:309
msgid "The sync failed. Nothing was left half-applied; you can run it again."
msgstr "La sincronización ha fallado. No ha quedado nada a medias; puedes volver a ejecutarla."

#: dfx-woo-role-changer.php:270
msgid "Role to be assigned to people purchasing this product."
msgstr "Perfil a asignar a las personas que compren este producto."

#: dfx-woo-role-changer.php:275
msgid " The role will be assigned and deassigned following the status of the subscription. "
msgstr " El perfil se asignará y se retirará según el estado de la suscripción. "

#: dfx-woo-role-changer.php:278
msgid " The premium version of the plugin supports assigning/deassigning roles based on product subscription status. "
msgstr " La versión premium del plugin permite la asignación/desasignación de perfiles basados en el estado de suscripción al producto. "

#. translators: %s: checkout URL
#: dfx-woo-role-changer.php:281
#, php-format
msgid "<a href=\"%s\">Upgrade to Pro</a> to get this feature."
msgstr "<a href=\"%s\">Actualiza a Pro</a> para conseguir esta característica."

#. translators: 1: role name, 2: user login
#: dfx-woo-role-changer.php:488
#, php-format
msgid "Added role \"%1$s\" to user \"%2$s\""
msgstr "Perfil “%1$s” agregado al usuario “%2$s”"

#. translators: 1: role name, 2: user login
#: dfx-woo-role-changer.php:546
#, php-format
msgid "Removed role \"%1$s\" from user \"%2$s\"."
msgstr "Perfil “%1$s” quitado del usuario “%2$s”."

#: dfx-woo-role-changer.php:556
msgid "Settings"
msgstr "Ajustes"

#: dfx-woo-role-changer.php:591
msgid "DFX Role Changer Settings"
msgstr "Ajustes de DFX Role Changer"

#: dfx-woo-role-changer.php:603
msgid "Role assignment mode"
msgstr "Modo de asignación de perfil"

#: dfx-woo-role-changer.php:607
msgid "Add/Remove Roles"
msgstr "Agregar/quitar perfiles"

#: dfx-woo-role-changer.php:608
msgid "Replace Roles"
msgstr "Reemplazar perfiles"

#: dfx-woo-role-changer.php:610
msgid "Choose the mode of role assignment. If you are using a plugin that allows managing multiple roles for a given user, you can choose to add or remove roles. If not, you should choose to replace the role."
msgstr "Selecciona el modo de asignación de perfiles. Si se utiliza un plugin que permita gestionar múltiples perfiles por usuario, puede seleccionar agregar o quitar perfiles. Si no, debería seleccionar reemplazar el perfil."

#: dfx-woo-role-changer.php:615
msgid "When to grant roles"
msgstr "Cuándo asignar perfiles"

#: dfx-woo-role-changer.php:619
msgid "On order payment"
msgstr "Al pagar pedido"

#: dfx-woo-role-changer.php:620
msgid "When order gets to Processing state"
msgstr "Cuando el pedido alcanza el estado En Proceso"

#: dfx-woo-role-changer.php:621
msgid "When order gets to Completed state"
msgstr "Cuando el pedido alcanza el estado Completado"

#: dfx-woo-role-changer.php:624
msgid "When in the order lifecycle the role should be granted. If you choose more than one option, the role will be granted at all the selected moments."
msgstr "Cuándo se debe asignar el perfil dentro del ciclo de vida del pedido. Si se elige más de una opción, el perfil de asignará en todos los momentos seleccionados."

#: dfx-woo-role-changer.php:638
msgid "Restrict your store by role: hide products and categories from the catalog and search, deny direct URL access, block add-to-cart, and set prices, payment gateways and shipping methods per role."
msgstr "Restringe tu tienda por perfil: oculta productos y categorías del catálogo y del buscador, deniega el acceso por URL directa, bloquea el añadir al carrito, y define precios, pasarelas de pago y métodos de envío por perfil."

#: dfx-woo-role-changer.php:639
msgid "Retroactive sync: align the roles of members who already existed before you configured the mapping, in batches and safe to re-run."
msgstr "Sincronización retroactiva: alinea los perfiles de los socios que ya existían antes de configurar la asignación, por lotes y reejecutable sin problema."

#: dfx-woo-role-changer.php:640
msgid "Unlimited MemberPress levels, several roles per membership, and a mapping for every membership state."
msgstr "Niveles de MemberPress ilimitados, varios perfiles por membresía y asignación para cada estado de la membresía."

#: dfx-woo-role-changer.php:641
msgid "Roles tied to subscription products, a role expiry period per product, roles per variation and several roles per product."
msgstr "Perfiles ligados a productos de suscripción, periodo de caducidad del perfil por producto, perfiles por variación y varios perfiles por producto."

#: dfx-woo-role-changer.php:650
msgid "Unlock Premium Features"
msgstr "Desbloquear características Premium"

#. translators: %s: checkout URL
#: dfx-woo-role-changer.php:655
#, php-format
msgid "<a href=\"%s\"><small>Unlock Premium Features</small></a>"
msgstr "<a href=\"%s\"><small>Desbloquear características Premium</small></a>"

